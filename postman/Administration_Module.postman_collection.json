{
  "info": {
    "name": "StoryVerse - Administration Module",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "accessToken", "value": "" },
    { "key": "flagId", "value": "" }
  ],
  "item": [
    {
      "name": "List Feature Flags",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/admin/feature-flags",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
      }
    },
    {
      "name": "Create Feature Flag",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/admin/feature-flags?name=ai_writing_assistant&description=Enable AI writing features",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
      }
    },
    {
      "name": "Enable Feature Flag",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/admin/feature-flags/{{flagId}}/enable",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
      }
    },
    {
      "name": "Disable Feature Flag",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/admin/feature-flags/{{flagId}}/disable",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
      }
    },
    {
      "name": "Get Config Value",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/admin/config/max_stories_per_user",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
      }
    },
    {
      "name": "Set Config Value",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/api/v1/admin/config/max_stories_per_user?value=100&description=Maximum stories per user",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
      }
    }
  ]
}
