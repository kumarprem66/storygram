{
  "info": {
    "name": "StoryVerse - Moderation Module",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "accessToken", "value": "" },
    { "key": "caseId", "value": "" },
    { "key": "targetId", "value": "" }
  ],
  "item": [
    {
      "name": "Report Content",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/moderation/report?targetId={{targetId}}&targetType=STORY&reason=SPAM&description=This%20looks%20like%20spam",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
      },
      "event": [{ "listen": "test", "script": { "exec": ["var j=pm.response.json(); if(j.data) pm.collectionVariables.set('caseId', j.data.caseId);"] } }]
    },
    {
      "name": "Resolve Case (Warning)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/moderation/cases/{{caseId}}/resolve?action=WARNING&notes=First%20offense%20-%20warning%20issued",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
      }
    }
  ]
}
