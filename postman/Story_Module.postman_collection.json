{
  "info": {
    "name": "StoryVerse - Story Module",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "accessToken", "value": "" },
    { "key": "storyId", "value": "" },
    { "key": "chapterId", "value": "" }
  ],
  "item": [
    {
      "name": "Create Story",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/stories",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"My First Story\",\n  \"description\": \"An amazing adventure tale\",\n  \"genre\": \"FANTASY\",\n  \"language\": \"en\"\n}"
        }
      },
      "event": [{ "listen": "test", "script": { "exec": ["var j=pm.response.json(); if(j.data) pm.collectionVariables.set('storyId', j.data.storyId);"] } }]
    },
    {
      "name": "Get Story",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/stories/{{storyId}}",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
      }
    },
    {
      "name": "Update Story",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/api/v1/stories/{{storyId}}",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Updated Story Title\",\n  \"subtitle\": \"A subtitle\",\n  \"description\": \"Updated description\",\n  \"genre\": \"SCIENCE_FICTION\",\n  \"tags\": [\"scifi\", \"adventure\"],\n  \"language\": \"en\",\n  \"ageRating\": \"TEEN\"\n}"
        }
      }
    },
    {
      "name": "Publish Story",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/stories/{{storyId}}/publish",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
      }
    },
    {
      "name": "Archive Story",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/stories/{{storyId}}/archive",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
      }
    },
    {
      "name": "Create Chapter",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/stories/{{storyId}}/chapters",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Chapter 1: The Beginning\",\n  \"content\": \"Once upon a time in a land far away, there lived a brave adventurer who sought the truth...\"\n}"
        }
      },
      "event": [{ "listen": "test", "script": { "exec": ["var j=pm.response.json(); if(j.data) pm.collectionVariables.set('chapterId', j.data.chapterId);"] } }]
    },
    {
      "name": "Update Chapter",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/api/v1/stories/{{storyId}}/chapters/{{chapterId}}",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Chapter 1: The Beginning (Revised)\",\n  \"content\": \"In the beginning, the world was shrouded in mystery...\"\n}"
        }
      }
    },
    {
      "name": "Delete Chapter",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/v1/stories/{{storyId}}/chapters/{{chapterId}}",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
      }
    }
  ]
}
